		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"ts-patch": "^3.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.9.3",
