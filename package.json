{
	"name": "itemsim",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt --write .",
		"lint": "pnpm format:check && pnpm lint:code",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"format:check": "oxfmt --check .",
		"lint:code": "oxlint . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@lucide/svelte": "1.56.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/load-config": "0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@ttsc/unplugin": "0.32.0",
		"@types/node": "24.19.2",
		"@typescript-eslint/parser": "8.71.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"eslint": "10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"mode-watcher": "^1.1.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"ttsc": "0.32.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typia": "^15.1.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"wrangler": "^4.149.0"
	},
	"dependencies": {
		"@malib/gear": "2.2.0",
		"@tanstack/svelte-query": "^6.3.2",
		"dexie": "^4.4.6",
		"es-hangul": "^2.4.0",
		"html-to-image": "^1.11.13",
		"html2canvas-pro": "1.6.7",
		"korean-regexp": "^1.0.13",
		"ky": "^2.2.0",
		"lz-string": "^1.5.0",
		"virtua": "^0.53.5"
	},
	"packageManager": "pnpm@12.16.1",
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
